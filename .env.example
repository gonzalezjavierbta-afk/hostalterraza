# ============================================================================
# .env.example -- Hostal Terraza / ExploraCO
# ============================================================================
# Copia este archivo a .env y rellena los valores en local. El .env real NO se
# versiona: si un valor real llega a un commit se considera una fuga y hay que
# rotarlo. Aqui solo hay nombres y defaults seguros, nunca credenciales.
#
# Los nombres son EXACTAMENTE los que el codigo lee. No inventes alias:
# MAIL_FROM no es FROM_EMAIL y WA_GRAPH_VERSION no es GRAPH_VERSION.
# ============================================================================

# ---------------------------------------------------------------------------
# WhatsApp Cloud API -- supabase/functions/send-wa-recordatorio (ADR-089, F2)
# ---------------------------------------------------------------------------
# Phone number id de la WABA (no es el numero de telefono).
WA_PHONE_NUMBER_ID=
# WhatsApp Business Account id.
WA_BUSINESS_ACCOUNT_ID=
# Token permanente de la WABA. NUNCA se loguea, nunca se versiona.
WA_TOKEN=
# Version del Graph API. Default del codigo si falta: v21.0.
WA_GRAPH_VERSION=v21.0
# Linea base obligatoria mientras no exista WABA ni plantilla aprobada:
# 1 = no se llama a graph.facebook.com (dry-run). 0 solo con canal aprobado.
WA_DRY_RUN=1
# Vacio en produccion. Solo se define para apuntar a un mock local (timeout).
WA_GRAPH_URL=
# Token del alta del webhook (wa-webhook, GET de verificacion de Meta).
WA_VERIFY_TOKEN=
# App secret de Meta: valida la firma X-Hub-Signature-256 del POST.
WA_APP_SECRET=

# ---------------------------------------------------------------------------
# Supabase -- Edge Functions (send-wa-recordatorio, send-ticket-email)
# ---------------------------------------------------------------------------
# Token compartido del canal pg_cron -> pg_net (header X-Service-Token).
SERVICE_SHARED_TOKEN=
SUPABASE_URL=
# Clave anon: solo se usa como clave HMAC para verificar la firma del JWT de
# sesion. NUNCA autoriza por si sola.
SUPABASE_ANON_KEY=
# Clave service_role: su rol esta bloqueado, nunca autoriza en estas funciones.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# CORS -- todas las Edge Functions
# ---------------------------------------------------------------------------
# CSV de origins permitidos. Si se define, jamas se responde "*".
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Correo -- supabase/functions/send-ticket-email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Remitente (por ejemplo: Taquilla Directa <no-reply@dominio>).
MAIL_FROM=
