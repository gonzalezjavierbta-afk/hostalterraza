# ============================================================
# HostalTerraza - .gitignore raiz
# ============================================================

# Archivos pesados de SOLO CONSULTA (no versionar).
# Se consultan bajo demanda; fuera del control de versiones para no
# ensuciar diffs, busquedas ni el contexto de las herramientas.
referentes/
prompt cambios mistico.txt

# Salidas de herramientas (pueden contener datos de sesion).
# El .gitignore interno de logs/uso/export/ ya cubre el caso.
logs/uso/export/*.json
logs/uso/export/*.csv

# Entorno y dependencias
node_modules/
.env
.env.*
!.env.example

# Sistema operativo / editores
Thumbs.db
desktop.ini
.DS_Store
